<?xml version="1.0" encoding="utf-8"?>
<!-- The widget has only the record. No app-drawn background, labels, controls,
     invisible gesture zones or extra click targets. Transparent corners reveal
     the user's wallpaper; the record itself is supplied as an ARGB bitmap. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">
    <ImageView
        android:id="@+id/vinyl_record"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:contentDescription="Vinyl record"
        android:src="@drawable/widget_vinyl_preview" />
</FrameLayout>
