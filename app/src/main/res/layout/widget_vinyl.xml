<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/vinyl_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass_background"
    android:contentDescription="Open Meowzix player">

    <ImageView
        android:id="@+id/vinyl_widget_disc"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:layout_margin="9dp"
        android:contentDescription="Vinyl cover art"
        android:scaleType="fitCenter" />

    <ImageView
        android:id="@+id/vinyl_widget_top"
        android:layout_width="42dp"
        android:layout_height="36dp"
        android:layout_gravity="top|center_horizontal"
        android:contentDescription="Double tap to like or unlike"
        android:padding="10dp"
        android:alpha="0.85"
        android:src="@drawable/live_song_favorite" />

    <ImageView
        android:id="@+id/vinyl_widget_bottom"
        android:layout_width="42dp"
        android:layout_height="36dp"
        android:layout_gravity="bottom|center_horizontal"
        android:contentDescription="Double tap to forward"
        android:padding="9dp"
        android:alpha="0.85"
        android:src="@drawable/ic_forward_paper_plane" />

    <ImageView
        android:id="@+id/vinyl_widget_left"
        android:layout_width="36dp"
        android:layout_height="42dp"
        android:layout_gravity="center_vertical|left"
        android:contentDescription="Double tap for previous track"
        android:padding="8dp"
        android:alpha="0.8"
        android:src="@drawable/widget_previous" />

    <ImageView
        android:id="@+id/vinyl_widget_right"
        android:layout_width="36dp"
        android:layout_height="42dp"
        android:layout_gravity="center_vertical|right"
        android:contentDescription="Double tap for next track"
        android:padding="8dp"
        android:alpha="0.8"
        android:src="@drawable/widget_next" />

    <ImageView
        android:id="@+id/vinyl_widget_center"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:background="@drawable/widget_vinyl_center_background"
        android:contentDescription="Play"
        android:padding="13dp"
        android:src="@drawable/widget_play" />
</FrameLayout>
