<?xml version="1.0" encoding="utf-8"?>
<!-- No card, square background, or visible controls. The record is the entire UI.
     Nine transparent, individually clickable cells prevent the launcher from
     treating directional/center taps as clicks on the widget root. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/vinyl_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- The touch grid and the artwork occupy one centered square, not the
         full rectangular widget host. All remaining host area is transparent. -->
    <FrameLayout
        android:id="@+id/vinyl_widget_disc_frame"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_gravity="center">

    <ImageView
        android:id="@+id/vinyl_widget_disc"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:contentDescription="Current album as a vinyl record"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_vinyl_placeholder" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/vinyl_widget_open_top_left"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="Open Meowzix player" />

            <TextView
                android:id="@+id/vinyl_widget_top"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="Double tap to like or unlike this track" />

            <TextView
                android:id="@+id/vinyl_widget_open_top_right"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="Open Meowzix player" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/vinyl_widget_left"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="Double tap for previous track" />

            <TextView
                android:id="@+id/vinyl_widget_center"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="Play or pause" />

            <TextView
                android:id="@+id/vinyl_widget_right"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="Double tap for next track" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/vinyl_widget_open_bottom_left"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="Open Meowzix player" />

            <TextView
                android:id="@+id/vinyl_widget_bottom"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="Double tap to forward this track" />

            <TextView
                android:id="@+id/vinyl_widget_open_bottom_right"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="Open Meowzix player" />
        </LinearLayout>
    </LinearLayout>
    </FrameLayout>
</FrameLayout>
