<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_queue_row"
    android:layout_width="match_parent"
    android:layout_height="42dp"
    android:background="@drawable/widget_queue_row_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingEnd="6dp">

    <TextView
        android:id="@+id/widget_queue_position"
        android:layout_width="22dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="01"
        android:textColor="#8ECDE7F3"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="6dp">

        <TextView
            android:id="@+id/widget_queue_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="Track"
            android:textColor="#F1F3FC"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_queue_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="none"
            android:maxLines="1"
            android:text="Artist"
            android:textColor="#A8BCC8DC"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
