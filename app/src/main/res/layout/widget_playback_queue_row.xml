<?xml version="1.0" encoding="utf-8"?>
<!-- Exactly one 56dp launcher-icon tall row. Only title and artist: the queue
     heading already tells the user these are upcoming songs. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_queue_row"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:background="@drawable/widget_queue_row_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="5dp"
    android:paddingBottom="5dp">

    <!-- Retained for RemoteViews compatibility, intentionally not displayed. -->
    <TextView
        android:id="@+id/widget_queue_position"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_queue_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Track"
            android:textSize="12sp"
            android:textColor="#FFFFFFFF"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_queue_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Artist"
            android:textSize="10sp"
            android:textColor="#CCFFFFFF" />
    </LinearLayout>
</LinearLayout>
