<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_playback_background"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="9dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_artwork"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:background="@drawable/widget_artwork_frame"
            android:clipToOutline="true"
            android:contentDescription="Open player"
            android:scaleType="centerCrop"
            android:src="@drawable/meowzix_logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="11dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="none"
                android:gravity="center_vertical"
                android:maxLines="2"
                android:text="Nothing playing"
                android:textColor="#FFF9FBFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="none"
                android:maxLines="1"
                android:text="Open Meowzix"
                android:textColor="#B9CFD5E9"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="43dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="43dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/widget_transport"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_previous"
                    android:layout_width="0dp"
                    android:layout_height="39dp"
                    android:layout_weight="1"
                    android:contentDescription="Previous track"
                    android:padding="9dp"
                    android:src="@drawable/widget_previous" />

                <ImageView
                    android:id="@+id/widget_play_pause"
                    android:layout_width="0dp"
                    android:layout_height="39dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_play_button_background"
                    android:contentDescription="Play"
                    android:padding="10dp"
                    android:src="@drawable/widget_play" />

                <ImageView
                    android:id="@+id/widget_next"
                    android:layout_width="0dp"
                    android:layout_height="39dp"
                    android:layout_weight="1"
                    android:contentDescription="Next track"
                    android:padding="9dp"
                    android:src="@drawable/widget_next" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_overflow_actions"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/widget_favorite"
                    android:layout_width="0dp"
                    android:layout_height="39dp"
                    android:layout_weight="1"
                    android:contentDescription="Like or unlike"
                    android:padding="9dp"
                    android:src="@drawable/live_song_favorite" />

                <ImageView
                    android:id="@+id/widget_forward"
                    android:layout_width="0dp"
                    android:layout_height="39dp"
                    android:layout_weight="1"
                    android:contentDescription="Forward track"
                    android:padding="9dp"
                    android:src="@drawable/ic_forward_paper_plane" />

                <ImageView
                    android:id="@+id/widget_shuffle"
                    android:layout_width="0dp"
                    android:layout_height="39dp"
                    android:layout_weight="1"
                    android:contentDescription="Shuffle"
                    android:padding="9dp"
                    android:src="@drawable/live_song_shuffle" />

                <ImageView
                    android:id="@+id/widget_repeat"
                    android:layout_width="0dp"
                    android:layout_height="39dp"
                    android:layout_weight="1"
                    android:contentDescription="Repeat"
                    android:padding="9dp"
                    android:src="@drawable/live_song_repeat" />
            </LinearLayout>
        </FrameLayout>

        <ImageView
            android:id="@+id/widget_more"
            android:layout_width="41dp"
            android:layout_height="39dp"
            android:background="@drawable/widget_more_button_background"
            android:contentDescription="More playback actions"
            android:padding="10dp"
            android:src="@drawable/widget_more" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_queue_section"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_queue_heading"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:gravity="center_vertical"
            android:paddingStart="5dp"
            android:text="UP NEXT"
            android:textColor="#D8DDE9F5"
            android:textSize="10sp"
            android:textStyle="bold" />

        <ListView
            android:id="@+id/widget_queue"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:cacheColorHint="@android:color/transparent"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="3dp"
            android:fadeScrollbars="true"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/widget_queue_empty"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="No tracks in queue"
            android:textColor="#9DADB8CB"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
