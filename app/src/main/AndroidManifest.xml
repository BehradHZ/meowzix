<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Live FFT visualization of the app playback session requires RECORD_AUDIO on Android. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Optional live song card; MediaSession playback itself remains notification-exempt. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- User-approved special app access for notification-triggered floating Forward picker. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:name=".MeowzixApplication"
        android:allowBackup="true"
        android:fullBackupContent="@xml/meowzix_backup_rules"
        android:dataExtractionRules="@xml/meowzix_data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Meowzix"
        android:supportsRtl="true"
        android:theme="@style/Theme.Meowzix">
        <!-- Required for Android Auto to discover this media-browser app. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <!-- Keep the real activity enabled for intents and shortcuts; launcher aliases
             change only the Home screen icon without disabling the running activity. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />

        <!-- Exactly one alias is enabled at a time. Original full-color artwork is unchanged. -->
        <activity-alias
            android:name=".LauncherIconMeowzixLight"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:label="Meowzix"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherIconMeowzixDark"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:label="Meowzix"
            android:icon="@mipmap/ic_launcher_meowzix_dark"
            android:roundIcon="@mipmap/ic_launcher_meowzix_dark">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherIconCoralLight"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:label="Meowzix"
            android:icon="@mipmap/ic_launcher_coral_light"
            android:roundIcon="@mipmap/ic_launcher_coral_light">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherIconCoralDark"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:label="Meowzix"
            android:icon="@mipmap/ic_launcher_coral_dark"
            android:roundIcon="@mipmap/ic_launcher_coral_dark">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherIconAmberLight"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:label="Meowzix"
            android:icon="@mipmap/ic_launcher_amber_light"
            android:roundIcon="@mipmap/ic_launcher_amber_light">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherIconAmberDark"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:label="Meowzix"
            android:icon="@mipmap/ic_launcher_amber_dark"
            android:roundIcon="@mipmap/ic_launcher_amber_dark">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherIconOceanLight"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:label="Meowzix"
            android:icon="@mipmap/ic_launcher_ocean_light"
            android:roundIcon="@mipmap/ic_launcher_ocean_light">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherIconOceanDark"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:label="Meowzix"
            android:icon="@mipmap/ic_launcher_ocean_dark"
            android:roundIcon="@mipmap/ic_launcher_ocean_dark">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherIconMintLight"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:label="Meowzix"
            android:icon="@mipmap/ic_launcher_mint_light"
            android:roundIcon="@mipmap/ic_launcher_mint_light">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherIconMintDark"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:label="Meowzix"
            android:icon="@mipmap/ic_launcher_mint_dark"
            android:roundIcon="@mipmap/ic_launcher_mint_dark">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherIconVioletLight"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:label="Meowzix"
            android:icon="@mipmap/ic_launcher_violet_light"
            android:roundIcon="@mipmap/ic_launcher_violet_light">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherIconVioletDark"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:label="Meowzix"
            android:icon="@mipmap/ic_launcher_violet_dark"
            android:roundIcon="@mipmap/ic_launcher_violet_dark">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherIconRoseLight"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:label="Meowzix"
            android:icon="@mipmap/ic_launcher_rose_light"
            android:roundIcon="@mipmap/ic_launcher_rose_light">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherIconRoseDark"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:label="Meowzix"
            android:icon="@mipmap/ic_launcher_rose_dark"
            android:roundIcon="@mipmap/ic_launcher_rose_dark">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Dynamic wallpaper-backed adaptive icons. Their backgrounds resolve
             from the OS Material You overlay, unlike nearest-preset color aliases. -->
        <activity-alias
            android:name=".LauncherIconWallpaperLight"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:label="Meowzix"
            android:icon="@mipmap/ic_launcher_wallpaper_light"
            android:roundIcon="@mipmap/ic_launcher_wallpaper_light">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherIconWallpaperDark"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:label="Meowzix"
            android:icon="@mipmap/ic_launcher_wallpaper_dark"
            android:roundIcon="@mipmap/ic_launcher_wallpaper_dark">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- No visible app screen: notification click uses the normal system activity transition. -->
        <activity
            android:name=".feature.telegram.TelegramForwardLaunchActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />

        <activity
            android:name=".feature.telegram.TelegramForwardActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:taskAffinity="dev.behradhz.meowzix.forward"
            android:theme="@style/Theme.Meowzix.ForwardOverlay" />

        <service
            android:name=".feature.telegram.TelegramForwardOverlayService"
            android:exported="false"
            android:stopWithTask="false" />

        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
            </intent-filter>
        </service>

        <!-- Explicit PendingIntent actions only; never exported to other apps. -->
        <receiver
            android:name=".playback.LiveSongControlsReceiver"
            android:exported="false" />

        <receiver
            android:name="androidx.media3.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- Square record widget; touch commands stay inside the app. -->
        <receiver
            android:name=".widget.VinylWidgetActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".widget.VinylWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/meowzix_vinyl_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.PlaybackWidgetActionReceiver"
            android:exported="false" />

        <service
            android:name=".widget.PlaybackWidgetQueueService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="true" />

        <receiver
            android:name=".widget.PlaybackWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/meowzix_playback_widget_info" />
        </receiver>
    </application>
</manifest>
