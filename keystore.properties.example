# Copy this file to keystore.properties and replace every placeholder.
# Never commit keystore.properties or the .jks/.keystore file.

MEOWZIX_KEYSTORE_FILE=meowzix-release.jks
MEOWZIX_KEYSTORE_PASSWORD=replace_with_keystore_password
MEOWZIX_KEY_ALIAS=meowzix
MEOWZIX_KEY_PASSWORD=replace_with_key_password
